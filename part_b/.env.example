# Sao chép thành .env rồi sửa. Không commit .env.

# --- Đường dẫn cục bộ ---
DATA_DIR=../data
INDEX_DIR=../data/index
MODELS_DIR=../models

# --- Index có phiên bản trên S3/MinIO: index/v{INDEX_VERSION}/ ---
INDEX_VERSION=dev
# true: tải index từ S3 lúc khởi động; false: đọc trực tiếp INDEX_DIR
INDEX_FROM_S3=false
# true: thiếu index thì /healthz 503 (Docker)
REQUIRE_INDEX=false
# true: tải models/{DENSE_MODEL}/ từ S3 (bản public không mount ../models)
MODELS_FROM_S3=false

# --- Object storage (MinIO local, Cloudflare R2 hoặc AWS S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=imgsearch
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
PRESIGN_TTL_SECONDS=600
# địa chỉ S3 trình duyệt tới được để ký URL thumbnail; trống = S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=

# --- Model ---
DENSE_ENABLED=true
DENSE_MODEL=siglip2-b32
DENSE_ONNX_FILE=text.onnx
DENSE_WEIGHT=2.0
DENSE_MIN_PROB=0.1
# 0 = mọi lõi; Docker: bằng số CPU của container
ONNX_THREADS=0
# cache vector truy vấn; 0 = tắt khi đo latency
QUERY_CACHE_SIZE=1024

# --- LLM parser tùy chọn (chỉ dùng khi quy tắc không phân tích được) ---
LLM_PARSER_ENABLED=false
LLM_TIMEOUT_SECONDS=1.5
ANTHROPIC_API_KEY=

# --- API ---
SAFE_SEARCH_DEFAULT=true
# false: client không tắt được lọc an toàn
ALLOW_UNSAFE_SEARCH=false
# Bản public (docker-compose.public.yml bắt buộc có): mật khẩu dùng chung, trống = không hỏi
DEMO_PASSWORD=
# số /search tối đa mỗi IP mỗi phút; 0 = không giới hạn (compose public đặt 30)
RATE_LIMIT_PER_MINUTE=0
MAX_QUERY_CHARS=300
# số truy vấn tính toán đồng thời; 0 = không giới hạn
SEARCH_CONCURRENCY=0

# --- Lọc an toàn (Q4): ngưỡng và tên cờ là giả định, chờ chính sách của mentor ---
NSFW_BLOCK_SCORE=0.8
UNSAFE_FLAGS=["nsfw","sexual"]

# --- Truy xuất ---
CANDIDATE_POOL=200
PER_PERSON_CAP=3

# --- Thumbnail: false = hotlink image_url gốc; true = presigned URL từ S3 cho ảnh có trong
# thumbs.txt (scripts/make_thumbs.py), ảnh còn lại hotlink ---
THUMBS_FROM_S3=false
# Demo cục bộ: ảnh từ ../data/raw/fetched qua /img/{id} (hotlink hỏng 9–19% ảnh). Docker: false
LOCAL_IMAGES=false

# --- Dịch vụ của mentor: kênh dense văn bản qwen3 (retrieval/mentor.py). Điền key thật vào .env,
# không commit. Đường hầm tạm thời: lỗi/timeout thì engine bỏ kênh, chạy BM25 + dense ảnh ---
MENTOR_API_KEY=
TEXT_EMBED_URL=https://<tunnel>/v1/embeddings
TEXT_EMBED_MODEL=qwen3-embedding-4b
RERANK_URL=https://<tunnel>/v1/rerank
RERANK_MODEL=jina-reranker-v2
MENTOR_TIMEOUT_SECONDS=1.0
# bật khi index có text_dense.npz (scripts/encode_texts.py) và có key
TEXT_DENSE_ENABLED=true
# dev thật: 0,5 tốt nhất (+0,02 nDCG); 1 và 2 làm giảm
TEXT_DENSE_WEIGHT=0.5
# cắt Matryoshka lúc nạp (server không nhận dimensions); 1024 x 90k float32 ~ 368 MB
TEXT_DENSE_DIM=1024
