# Sao chép thành .env rồi sửa. Không commit .env.

# --- Đường dẫn cục bộ ---
DATA_DIR=../data
INDEX_DIR=../data/index
MODELS_DIR=../models

# --- Index có phiên bản trên S3/MinIO: index/v{INDEX_VERSION}/ ---
INDEX_VERSION=dev
# true: tải index từ S3 lúc khởi động; false: đọc trực tiếp INDEX_DIR
INDEX_FROM_S3=false

# --- Object storage (MinIO local, Cloudflare R2 hoặc AWS S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=imgsearch
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
PRESIGN_TTL_SECONDS=600

# --- Model ---
DENSE_ENABLED=true
DENSE_MODEL=siglip2-b32
DENSE_ONNX_FILE=text.onnx
DENSE_WEIGHT=2.0
DENSE_MIN_PROB=0.1

# --- LLM parser tùy chọn (chỉ dùng khi quy tắc không phân tích được) ---
LLM_PARSER_ENABLED=false
LLM_TIMEOUT_SECONDS=1.5
ANTHROPIC_API_KEY=

# --- API ---
SAFE_SEARCH_DEFAULT=true
MAX_QUERY_CHARS=300
RESULT_CACHE_ENABLED=true

# --- Lọc an toàn (Q4): ngưỡng và tên cờ là giả định, chờ chính sách của mentor ---
NSFW_BLOCK_SCORE=0.8
UNSAFE_FLAGS=["nsfw","sexual"]

# --- Truy xuất ---
CANDIDATE_POOL=200
PER_PERSON_CAP=3

# --- Thumbnail: false = hotlink image_url gốc; true = presigned URL từ S3 ---
THUMBS_FROM_S3=false
